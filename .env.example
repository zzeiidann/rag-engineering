# Local demonstration values only. Replace tokens/passwords before using real data.
NEO4J_PASSWORD=local-graph-password
MILVUS_URI=http://localhost:19530
NEO4J_URI=bolt://localhost:7687
CATALOG_PATH=var/catalog.db
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
AUTH_TOKENS_JSON='{"demo-client-a":{"user_id":"user_a","role":"client","client_id":"client_a"},"demo-client-b":{"user_id":"user_b","role":"client","client_id":"client_b"},"demo-actuarial":{"user_id":"actuary","role":"internal","department":"actuarial"},"demo-sales":{"user_id":"sales","role":"internal","department":"sales"},"demo-sales-permitted":{"user_id":"sales_special","role":"internal","department":"sales","permissions":["resource:read:actuarial_pricing"]},"demo-ingest":{"user_id":"ingest","role":"internal","department":"engineering","permissions":["documents:write","retrieval:debug"]}}'
AUTH_SERVICE_URL=
AUTH_SERVICE_SECRET=replace-with-a-long-random-shared-secret
AUTH_SECRET_KEY=replace-with-a-long-random-session-secret
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=replace-this-bootstrap-password
AUTH_TOKEN_TTL_HOURS=24
AUTH_COOKIE_SECURE=false
# Flask browser gateway target; Docker Compose defaults to http://api:8000.
# When running Flask outside Docker, use http://127.0.0.1:8000.
RAG_API_URL=http://api:8000
DEBUG_RETRIEVAL=false
VECTOR_TOP_K=20
GRAPH_TOP_K=20
CONTEXT_TOP_K=5
SIMILARITY_THRESHOLD=0.35
ALPHA=0.65
BETA=0.25
GAMMA=0.10
